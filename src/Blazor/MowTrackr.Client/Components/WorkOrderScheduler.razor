@inherits PageBase
@inject IMaintenanceApiService MaintenanceApi
@inject IUserApiService UserApi
@inject DialogService Dialogs

<EditForm Model="_model" OnValidSubmit="@(() => RunOnceAsync("save", SaveAsync))">
    <RadzenStack Gap="0.75rem">
        <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
            @_error
        </RadzenAlert>
        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">
            @Item?.MowerName
        </RadzenText>
        <div>
            <RadzenLabel Text="@L["Assign to"]" Component="Assignee" />
            <RadzenDropDown TValue="Guid?" @bind-Value="_model.AssignedToUserId" Data="_users" TextProperty="DisplayName" ValueProperty="Id" Name="Assignee" AllowClear="true" Placeholder="@L["Unassigned"]" Style="width: 100%" />
        </div>
        <div>
            <RadzenLabel Text="@L["Scheduled for"]" Component="ScheduledFor" />
            <RadzenDatePicker TValue="DateOnly?" @bind-Value="_model.ScheduledFor" Name="ScheduledFor" DateFormat="d" AllowClear="true" Style="width: 100%" />
        </div>
        <div>
            <RadzenLabel Text="@L["Notes"]" Component="Notes" />
            <RadzenTextArea @bind-Value="_model.Notes" Name="Notes" Rows="3" Style="width: 100%" />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Schedule"]" IsBusy="@IsRunning("save")" Disabled="@IsRunning("save")" />
        </RadzenStack>
    </RadzenStack>
</EditForm>

@code {
    private readonly WorkOrderCreateRequest _model = new();

    private List<UserResponse> _users = [];

    private string? _error;
    /// <summary>Gets or sets the due item being scheduled.</summary>
    [Parameter]
    public MaintenanceDueResponse? Item { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (Item is not null)
        {
            _model.MowerId = Item.MowerId;

            _model.ServiceTemplateId = Item.ServiceTemplateId;
        }

        var result = await UserApi.ListAsync(Cancellation);

        _users = result.Value ?? [];
    }

    /// <summary>Creates the work order and closes the dialog.</summary>
    /// <returns>A task.</returns>
    private async Task SaveAsync()
    {
        _error = null;

        var result = await MaintenanceApi.CreateWorkOrderAsync(_model, Cancellation);

        if (result.IsSuccess)
        {
            NotifySuccess(L["Work order scheduled."]);

            Dialogs.Close(true);

            return;
        }

        _error = result.Error;
    }
}