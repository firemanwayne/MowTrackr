@inherits PageBase
@inject IServiceTemplateApiService TemplateApi
@inject IInspectionTemplateApiService InspectionApi
@inject IAssetTypeApiService AssetTypeApi
@inject IUnitApiService UnitApi
@inject DialogService Dialogs

<EditForm Model="_model" OnValidSubmit="@(() => RunOnceAsync("save", SaveAsync))">
    <DataAnnotationsValidator />
    <RadzenStack Gap="0.75rem">
        <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
            @_error
        </RadzenAlert>
        <div>
            <RadzenLabel Text="@L["Applies to"]" Component="AssetTypes" />
            <RadzenDropDown TValue="IEnumerable<Guid>" Value="@(_model.AssetTypeIds.AsEnumerable())" ValueChanged="OnAssetTypesChangedAsync" Data="_assetTypes" TextProperty="Name" ValueProperty="Id" Name="AssetTypes" Multiple="true" Chips="true" AllowClear="true" AllowFiltering="true" Placeholder="@L["Select one or more types"]" Style="width: 100%" />
        </div>
        <div>
            <RadzenLabel Text="@L["Name"]" Component="Name" />
            <RadzenTextBox @bind-Value="_model.Name" Name="Name" Placeholder="@L["e.g. Annual Inspection"]" Style="width: 100%" />
            <ValidationMessage For="@(() => _model.Name)" />
        </div>
        <div>
            <RadzenLabel Text="@L["Description"]" Component="Description" />
            <RadzenTextArea @bind-Value="_model.Description" Name="Description" Rows="2" Style="width: 100%" />
        </div>
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Due every (engine hours)"]" Component="IntervalHours" />
                <RadzenNumeric TValue="decimal?" Value="_model.IntervalHours" ValueChanged="OnHoursChangedAsync" Name="IntervalHours" Min="0" Step="1" Placeholder="@L["optional"]" Style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Due every (days)"]" Component="IntervalDays" />
                <RadzenNumeric TValue="int?" Value="_model.IntervalDays" ValueChanged="OnDaysChangedAsync" Name="IntervalDays" Min="0" Step="1" Placeholder="@L["optional"]" Style="width: 100%" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenText TextStyle="TextStyle.Caption">
            @L["Set hours, days, or both. Whichever comes first makes the service due."]
        </RadzenText>
        @foreach (var issue in _issues)
        {
            <RadzenAlert AlertStyle="@(issue.Severity == IssueSeverity.Error ? AlertStyle.Danger : AlertStyle.Warning)" AllowClose="false" Variant="Variant.Flat" Size="AlertSize.Small">
                @issue.Message
            </RadzenAlert>
        }
        <div>
            <RadzenCheckBox TValue="bool" @bind-Value="_model.IsActive" Name="IsActive" />
            <RadzenLabel Text="@L["Active (used for due checks)"]" Component="IsActive" class="rz-ms-2" />
        </div>
        <div>
            <RadzenLabel Text="@L["Pre-check (before the work starts)"]" Component="PreChecks" />
            <RadzenDropDown TValue="IEnumerable<Guid>" Value="@(SelectedOf(InspectionTiming.Before))" ValueChanged="@(value => SelectInspections(InspectionTiming.Before, value))" Data="@(AvailableFor(InspectionTiming.Before))" TextProperty="Name" ValueProperty="Id" Name="PreChecks" Multiple="true" Chips="true" AllowClear="true" Placeholder="@L["None"]" Style="width: 100%" />
        </div>
        <div>
            <RadzenLabel Text="@L["Post-check (after the work is done)"]" Component="PostChecks" />
            <RadzenDropDown TValue="IEnumerable<Guid>" Value="@(SelectedOf(InspectionTiming.After))" ValueChanged="@(value => SelectInspections(InspectionTiming.After, value))" Data="@(AvailableFor(InspectionTiming.After))" TextProperty="Name" ValueProperty="Id" Name="PostChecks" Multiple="true" Chips="true" AllowClear="true" Placeholder="@L["None"]" Style="width: 100%" />
        </div>
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">
            @L["Service steps"]
        </RadzenText>
        @for (var i = 0; i < _model.Tasks.Count; i++)
        {
            var index = i;

            var task = _model.Tasks[index];

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="task.Description" Placeholder="@L["Task description"]" Style="flex: 1; min-width: 200px" />
                <RadzenCheckBox TValue="bool" @bind-Value="task.IsRequired" Name="@($"required-{index}")" />
                <RadzenLabel Text="@L["Required"]" Component="@($"required-{index}")" />
                <RadzenCheckBox TValue="bool" Value="@(task.Condition == ServiceTaskCondition.AssetHasTires)" Change="@(value => task.Condition = value ? ServiceTaskCondition.AssetHasTires : ServiceTaskCondition.Always)" Name="@($"tires-{index}")" />
                <RadzenLabel Text="@L["Only if the type has tires"]" Component="@($"tires-{index}")" />
                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => _model.Tasks.RemoveAt(index))" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-ms-4">
                <RadzenLabel Text="@L["Quantity"]" />
                <RadzenDropDown TValue="DetailRequirement" @bind-Value="task.QuantityRequirement" Data="_requirements" TextProperty="Text" ValueProperty="Value" Style="width: 120px" />
                @if (task.QuantityRequirement != DetailRequirement.None)
                {
                    <RadzenDropDown TValue="QuantityUnitSource" @bind-Value="task.QuantityUnitSource" Data="_unitSources" TextProperty="Text" ValueProperty="Value" Style="width: 230px" />
                    @if (task.QuantityUnitSource == QuantityUnitSource.StepUnit)
                    {
                        <RadzenDropDown TValue="Guid?" @bind-Value="task.UnitId" Data="_units" TextProperty="Name" ValueProperty="Id" Placeholder="@L["Unit"]" Style="width: 130px" />
                    }
                }
                <RadzenLabel Text="@L["Part number"]" />
                <RadzenDropDown TValue="DetailRequirement" @bind-Value="task.PartNumberRequirement" Data="_requirements" TextProperty="Text" ValueProperty="Value" Style="width: 120px" />
                <RadzenLabel Text="@L["Notes"]" />
                <RadzenDropDown TValue="DetailRequirement" @bind-Value="task.NotesRequirement" Data="_requirements" TextProperty="Text" ValueProperty="Value" Style="width: 120px" />
            </RadzenStack>
        }
        <div>
            <RadzenButton Text="@L["Add task"]" Icon="add" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => _model.Tasks.Add(new ServiceTaskRequest()))" />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" IsBusy="@IsRunning("save")" Disabled="@IsRunning("save")" />
        </RadzenStack>
    </RadzenStack>
</EditForm>

@code {
    private ServiceTemplateRequest _model = new();

    private IReadOnlyList<IntervalIssue> _issues = [];

    private List<AssetTypeResponse> _assetTypes = [];

    private sealed record RequirementOption(DetailRequirement Value, string Text);

    private sealed record UnitSourceOption(QuantityUnitSource Value, string Text);

    private List<InspectionTemplateResponse> _inspections = [];

    private List<UnitOfMeasureResponse> _units = [];

    private List<RequirementOption> _requirements = [];

    private List<UnitSourceOption> _unitSources = [];

    private string? _error;

    /// <summary>Gets or sets the template being edited; <see langword="null"/> creates a new one.</summary>
    [Parameter]
    public ServiceTemplateResponse? Existing { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var types = await AssetTypeApi.ListAsync(Cancellation);

        _assetTypes = types.Value ?? [];

        _error = types.IsSuccess ? null : types.Error;

        _requirements =
        [
            new RequirementOption(DetailRequirement.None, L["Not asked"]),
            new RequirementOption(DetailRequirement.Optional, L["Optional"]),
            new RequirementOption(DetailRequirement.Required, L["Required"]),
        ];

        _unitSources =
        [
            new UnitSourceOption(QuantityUnitSource.StepUnit, L["Unit chosen here"]),
            new UnitSourceOption(QuantityUnitSource.AssetOil, L["The equipment's oil unit"]),
        ];

        var unitList = await UnitApi.ListAsync(Cancellation);

        _units = unitList.Value ?? [];

        var checks = await InspectionApi.ListAsync(Cancellation);

        _inspections = checks.Value ?? [];

        if (Existing is null)
        {
            _model.Tasks.Add(new ServiceTaskRequest());

            return;
        }

        _model = new ServiceTemplateRequest
        {
            Name = Existing.Name,
            AssetTypeIds = Existing.AssetTypes.Select(t => t.Id).ToList(),
            InspectionTemplateIds = Existing.Inspections.Select(i => i.Id).ToList(),
            Description = Existing.Description,
            IntervalHours = Existing.IntervalHours,
            IntervalDays = Existing.IntervalDays,
            IsActive = Existing.IsActive,
            Tasks = Existing.Tasks.Select(t => new ServiceTaskRequest
            {
                Description = t.Description,
                IsRequired = t.IsRequired,
                Condition = t.Condition,
                QuantityRequirement = t.QuantityRequirement,
                QuantityUnitSource = t.QuantityUnitSource,
                UnitId = t.UnitId,
                PartNumberRequirement = t.PartNumberRequirement,
                NotesRequirement = t.NotesRequirement,
            }).ToList(),
        };
    }

    /// <summary>Handles a change to the asset types and re-validates, since intervals are compared within a type.</summary>
    /// <param name="value">The chosen type keys.</param>
    /// <returns>A task.</returns>
    private Task OnAssetTypesChangedAsync(IEnumerable<Guid> value)
    {
        _model.AssetTypeIds = value?.ToList() ?? [];

        // Drop assigned inspections that are limited to a type this service no longer covers.
        var allowed = _inspections.Where(i => IsAvailable(i)).Select(i => i.Id).ToHashSet();

        _model.InspectionTemplateIds = _model.InspectionTemplateIds.Where(allowed.Contains).ToList();

        return CheckAsync();
    }

    /// <summary>Handles a change to the hours interval and re-validates.</summary>
    /// <param name="value">The new value.</param>
    /// <returns>A task.</returns>
    private Task OnHoursChangedAsync(decimal? value)
    {
        _model.IntervalHours = value is > 0 ? value : null;

        return CheckAsync();
    }

    /// <summary>Handles a change to the days interval and re-validates.</summary>
    /// <param name="value">The new value.</param>
    /// <returns>A task.</returns>
    private Task OnDaysChangedAsync(int? value)
    {
        _model.IntervalDays = value is > 0 ? value : null;

        return CheckAsync();
    }

    /// <summary>Checks whether an inspection can be used with the chosen asset types.</summary>
    /// <param name="inspection">The inspection.</param>
    /// <returns><see langword="true"/> when it applies to any type, or to one of the chosen types.</returns>
    private bool IsAvailable(InspectionTemplateResponse inspection)
    {
        return inspection.IsActive && (inspection.AssetTypeId is null || _model.AssetTypeIds.Contains(inspection.AssetTypeId.Value));
    }

    /// <summary>Lists the inspections that can be assigned with a given timing.</summary>
    /// <param name="timing">Pre-check or post-check.</param>
    /// <returns>The inspections.</returns>
    private List<InspectionTemplateResponse> AvailableFor(InspectionTiming timing)
    {
        return _inspections.Where(i => i.Timing == timing && IsAvailable(i)).ToList();
    }

    /// <summary>Lists the assigned inspections with a given timing.</summary>
    /// <param name="timing">Pre-check or post-check.</param>
    /// <returns>The inspection keys.</returns>
    private IEnumerable<Guid> SelectedOf(InspectionTiming timing)
    {
        var ofTiming = _inspections.Where(i => i.Timing == timing).Select(i => i.Id).ToHashSet();

        return _model.InspectionTemplateIds.Where(ofTiming.Contains).ToList();
    }

    /// <summary>Replaces the assigned inspections of one timing with the chosen ones.</summary>
    /// <param name="timing">Pre-check or post-check.</param>
    /// <param name="chosen">The chosen inspection keys.</param>
    private void SelectInspections(InspectionTiming timing, IEnumerable<Guid> chosen)
    {
        var ofTiming = _inspections.Where(i => i.Timing == timing).Select(i => i.Id).ToHashSet();

        var kept = _model.InspectionTemplateIds.Where(id => !ofTiming.Contains(id));

        _model.InspectionTemplateIds = kept.Concat(chosen ?? []).Distinct().ToList();
    }

    /// <summary>Asks the API whether the current interval duplicates or overlaps another template.</summary>
    /// <returns>A task.</returns>
    private async Task CheckAsync()
    {
        var request = new IntervalCheckRequest
        {
            IntervalHours = _model.IntervalHours,
            IntervalDays = _model.IntervalDays,
            AssetTypeIds = _model.AssetTypeIds,
            ExcludeTemplateId = Existing?.Id,
        };

        var result = await TemplateApi.CheckIntervalsAsync(request, Cancellation);

        _issues = result.Value ?? [];
    }

    /// <summary>Saves the template; blocking conflicts are shown inline.</summary>
    /// <returns>A task.</returns>
    private async Task SaveAsync()
    {
        _error = null;

        var result = Existing is null
            ? await TemplateApi.CreateAsync(_model, Cancellation)
            : await TemplateApi.UpdateAsync(Existing.Id, _model, Cancellation);

        if (result.IsSuccess)
        {
            NotifySuccess(L["Template saved."]);

            Dialogs.Close(true);

            return;
        }

        if (result.Value?.Issues is { Count: > 0 } issues)
        {
            _issues = issues;
        }
        else
        {
            _error = result.Error;
        }
    }
}
