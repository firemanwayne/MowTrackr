@inherits PageBase
@inject DialogService Dialogs

<EditForm Model="_model" OnValidSubmit="@(() => RunOnceAsync("save", SaveAsync))">
    <DataAnnotationsValidator />
    <RadzenStack Gap="0.75rem">
        <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
            @_error
        </RadzenAlert>
        <div>
            <RadzenLabel Text="@L["Name"]" Component="LookupName" />
            <RadzenTextBox @bind-Value="_model.Name" Name="LookupName" Style="width: 100%" />
            <ValidationMessage For="@(() => _model.Name)" />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(null))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" IsBusy="@IsRunning("save")" Disabled="@IsRunning("save")" />
        </RadzenStack>
    </RadzenStack>
</EditForm>

@code {
    private readonly ManufacturerRequest _model = new();

    private string? _error;

    /// <summary>Gets or sets the name to start with (when renaming).</summary>
    [Parameter]
    public string? InitialName { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _model.Name = InitialName ?? string.Empty;
    }

    /// <summary>Gets or sets the save action: given the entered name, returns the new key or an error message.</summary>
    [Parameter, EditorRequired]
    public Func<ManufacturerRequest, CancellationToken, Task<(Guid? Id, string? Error)>> OnSave { get; set; } = default!;

    /// <summary>Saves the name and closes the dialog, returning the new key.</summary>
    /// <returns>A task.</returns>
    private async Task SaveAsync()
    {
        _error = null;

        var (id, error) = await OnSave(_model, Cancellation);

        if (id is not null)
        {
            Dialogs.Close(id);

            return;
        }

        _error = error;
    }
}
