@inherits PageBase
@inject IOilTypeApiService OilTypeApi
@inject DialogService Dialogs

<EditForm Model="_model" OnValidSubmit="@(() => RunOnceAsync("save", SaveAsync))">
    <DataAnnotationsValidator />
    <RadzenStack Gap="0.75rem">
        <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
            @_error
        </RadzenAlert>
        <div>
            <RadzenLabel Text="@L["Name"]" Component="OilTypeName" />
            <RadzenTextBox @bind-Value="_model.Name" Name="OilTypeName" Placeholder="@L["e.g. SAE 10W-30"]" Style="width: 100%" />
            <ValidationMessage For="@(() => _model.Name)" />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" IsBusy="@IsRunning("save")" Disabled="@IsRunning("save")" />
        </RadzenStack>
    </RadzenStack>
</EditForm>

@code {
    private readonly OilTypeRequest _model = new();

    private string? _error;

    /// <summary>Gets or sets the oil type being edited; <see langword="null"/> adds a new one.</summary>
    [Parameter]
    public OilTypeResponse? Existing { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _model.Name = Existing?.Name ?? string.Empty;
    }

    /// <summary>Saves the oil type and closes the dialog.</summary>
    /// <returns>A task.</returns>
    private async Task SaveAsync()
    {
        _error = null;

        var result = Existing is null
            ? await OilTypeApi.CreateAsync(_model, Cancellation)
            : await OilTypeApi.UpdateAsync(Existing.Id, _model, Cancellation);

        if (result.IsSuccess)
        {
            Dialogs.Close(true);

            return;
        }

        _error = result.Error;
    }
}
