<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>MowTrackr.Client</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Spanish number/date formats need the full ICU data set. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MowTrackr.Client.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UseCases\MowTrackr.Application\MowTrackr.Application.csproj" />
    <ProjectReference Include="..\..\Abstractions\MowTrackr.Core\MowTrackr.Core.csproj" />
    <ProjectReference Include="..\..\Infrastructure\MowTrackr.Localization\MowTrackr.Localization.csproj" />
  </ItemGroup>

</Project>