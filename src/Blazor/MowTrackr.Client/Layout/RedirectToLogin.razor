@inject NavigationManager Navigation
@inject ISessionExpiry Expiry

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // A session that ended on its own gets an explanation; someone who simply was not signed in does not.
        Navigation.NavigateTo(Expiry.ConsumeNotice() ? "login?expired=true" : "login", replace: true);
    }
}