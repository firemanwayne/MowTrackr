@page "/mowers"
@attribute [Authorize]
@inherits PageBase
@inject IMowerApiService MowerApi
@inject DialogService Dialogs

<div class="page">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <h1>@L["Mowers"]</h1>
        <AuthorizeView Roles="@AppRoles.ManagerOrAdmin">
            <RadzenButton Text="@L["Add mower"]" Icon="add" Disabled="@IsRunning("add")" Click="@(() => RunOnceAsync("add", () => EditAsync(null)))" />
        </AuthorizeView>
    </RadzenStack>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid class="app-grid" Responsive="true" AllowColumnResize="true" ColumnWidth="150px" Data="_mowers" TItem="MowerResponse" IsLoading="_loading" AllowSorting="true" AllowFiltering="true" AllowPaging="true" PageSize="15">
        <Columns>
            <RadzenDataGridColumn TItem="MowerResponse" Property="Name" Title="@L["Name"]" MinWidth="160px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="AssetType" Title="@L["Type"]" Width="120px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="Manufacturer" CssClass="hide-sm" Title="@L["Manufacturer"]" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="Model" Title="@L["Model"]" Width="120px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="SerialNumber" CssClass="hide-sm" Title="@L["S/N"]" MinWidth="130px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="PurchaseDate" CssClass="hide-sm" Title="@L["Purchased"]" FormatString="{0:d}" MinWidth="120px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="EngineHours" Title="@L["Engine hrs"]" FormatString="{0:0.#}" Width="95px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="OilType" CssClass="hide-sm" Title="@L["Oil"]" Width="110px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="OilQuantityQuarts" CssClass="hide-sm" Title="@L["Qts"]" Width="70px" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="LastOilChange" CssClass="hide-sm" Title="@L["Last oil change"]" FormatString="{0:d}" MinWidth="150px" />
            <RadzenDataGridColumn TItem="MowerResponse" Title="@L["Active"]" Sortable="false" Filterable="false" Width="90px">
                <Template Context="mower">
                    <RadzenBadge Text="@(mower.IsActive ? L["Active"] : L["Retired"])" BadgeStyle="@(mower.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" />
                </Template>
            </RadzenDataGridColumn>
            <AuthorizeView Roles="@AppRoles.ManagerOrAdmin">
                <RadzenDataGridColumn TItem="MowerResponse" Title="" Sortable="false" Filterable="false" Width="150px">
                    <Template Context="mower">
                        <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                            <RadzenButton Icon="history" Variant="Variant.Text" Size="ButtonSize.Small" title="@L["History"]" Disabled="@IsRunning($"history-{mower.Id}")" Click="@(() => RunOnceAsync($"history-{mower.Id}", () => ShowHistoryAsync(mower)))" />
                        </AuthorizeView>
                        <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@IsRunning($"edit-{mower.Id}")" Click="@(() => RunOnceAsync($"edit-{mower.Id}", () => EditAsync(mower)))" />
                        <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@IsRunning($"delete-{mower.Id}")" Click="@(() => RunOnceAsync($"delete-{mower.Id}", () => DeleteAsync(mower)))" />
                    </Template>
                </RadzenDataGridColumn>
            </AuthorizeView>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<MowerResponse> _mowers = [];

    private string? _error;

    private bool _loading = true;

    /// <inheritdoc />
    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    /// <summary>Loads the mowers.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await MowerApi.ListAsync(Cancellation);

        _mowers = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        _loading = false;
    }

    /// <summary>Opens the change history of one mower (admins only).</summary>
    /// <param name="mower">The mower.</param>
    /// <returns>A task.</returns>
    private async Task ShowHistoryAsync(MowerResponse mower)
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(HistoryDialog.EntityType)] = HistoryEntityTypes.Mower,
            [nameof(HistoryDialog.EntityId)] = mower.Id,
        };

        await Dialogs.OpenAsync<HistoryDialog>(L["History: {0}", mower.Name], parameters, new DialogOptions { Width = "760px" });
    }

    /// <summary>Opens the editor for a new or existing mower and reloads if it was saved.</summary>
    /// <param name="mower">The mower to edit, or <see langword="null"/> to add one.</param>
    /// <returns>A task.</returns>
    private async Task EditAsync(MowerResponse? mower)
    {
        var parameters = new Dictionary<string, object?> { [nameof(MowerEditor.Existing)] = mower };

        var saved = await Dialogs.OpenAsync<MowerEditor>(mower is null ? L["Add mower"] : L["Edit mower"], parameters, new DialogOptions { Width = "640px" });

        if (saved is true)
        {
            await LoadAsync();
        }
    }

    /// <summary>Deletes a mower after confirmation.</summary>
    /// <param name="mower">The mower.</param>
    /// <returns>A task.</returns>
    private async Task DeleteAsync(MowerResponse mower)
    {
        var confirmed = await Dialogs.Confirm(L["Delete {0}? This cannot be undone.", mower.Name], L["Delete mower"], new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] });

        if (confirmed is not true)
        {
            return;
        }

        var result = await MowerApi.DeleteAsync(mower.Id, Cancellation);

        if (!result.IsSuccess)
        {
            NotifyError(result.Error ?? L["Could not delete the mower."]);

            return;
        }

        NotifySuccess(L["Mower deleted."]);

        await LoadAsync();
    }
}