@page "/login"
@attribute [AllowAnonymous]
@inherits PageBase
@inject IAuthApiService Auth
@inject ISessionService Session
@inject NavigationManager Navigation

<PageTitle>@L["Sign in"] - MowTrackr</PageTitle>

<div class="auth-card">
    <LanguagePicker />
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H5">
            @L["Sign in to MowTrackr"]
        </RadzenText>
        <EditForm Model="_model" OnValidSubmit="@(() => RunOnceAsync("signin", SignInAsync))">
            <DataAnnotationsValidator />
            <RadzenStack Gap="0.75rem">
                <RadzenAlert Visible="@Expired" AlertStyle="AlertStyle.Info" AllowClose="false" Variant="Variant.Flat">
                    @L["Your session has expired. Please sign in again."]
                </RadzenAlert>
                <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false" Variant="Variant.Flat">
                    @_error
                </RadzenAlert>
                @if (_needsConfirmation)
                {
                    <RadzenButton Text="@L["Resend confirmation email"]" Variant="Variant.Outlined" IsBusy="@IsRunning("resend")" Disabled="@IsRunning("resend")" Click="@(() => RunOnceAsync("resend", ResendConfirmationAsync))" />
                }
                <div>
                    <RadzenLabel Text="@L["Email"]" Component="Email" />
                    <RadzenTextBox @bind-Value="_model.Email" Name="Email" inputmode="email" autocomplete="username" Style="width: 100%" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Password"]" Component="Password" />
                    <RadzenPassword @bind-Value="_model.Password" Name="Password" autocomplete="current-password" Style="width: 100%" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>
                <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Sign in"]" IsBusy="@IsRunning("signin")" Disabled="@IsRunning("signin")" />
            </RadzenStack>
        </EditForm>
        @if (_providers.Count > 0)
        {
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-4">
                @L["Or continue with"]
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                @foreach (var provider in _providers)
                {
                    <RadzenButton Text="@provider" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="@(() => ExternalSignIn(provider))" />
                }
            </RadzenStack>
        }
        @if (_registrationOpen)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-4">
                @L["No accounts exist yet."] <a href="register">@L["Create the first account"]</a>
            </RadzenText>
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-4">
                @L["Access is by invitation. Ask your administrator to invite you."]
            </RadzenText>
        }
    </RadzenCard>
</div>

@code {
    private readonly LoginRequest _model = new();

    private List<string> _providers = [];

    private string? _error;

    private bool _needsConfirmation;

    /// <summary>Gets or sets a value indicating that the user arrived because their session ended.</summary>
    [SupplyParameterFromQuery(Name = "expired")]
    public bool Expired { get; set; }

    private bool _registrationOpen;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var result = await Auth.GetProvidersAsync(Cancellation);

        if (result.IsSuccess)
        {
            _providers = result.Value ?? [];
        }

        var registration = await Auth.GetRegistrationStatusAsync(Cancellation);

        _registrationOpen = registration.Value?.IsOpen == true;
    }

    /// <summary>Signs in with email and password.</summary>
    /// <returns>A task.</returns>
    private async Task SignInAsync()
    {
        _error = null;

        _needsConfirmation = false;

        var result = await Auth.LoginAsync(_model, Cancellation);

        if (result.IsSuccess && result.Value is not null)
        {
            var reload = await Session.SignInAsync(result.Value.Token, Cancellation);

            Navigation.NavigateTo("", forceLoad: reload, replace: true);

            return;
        }

        _error = result.Error;

        // A correct password on an unconfirmed account comes back as Forbidden: offer a new confirmation email.
        _needsConfirmation = result.StatusCode == HttpStatusCode.Forbidden;
    }

    /// <summary>Asks for a new confirmation email for the address typed in the form.</summary>
    /// <returns>A task.</returns>
    private async Task ResendConfirmationAsync()
    {
        var result = await Auth.ResendConfirmationAsync(_model.Email, Cancellation);

        if (result.IsSuccess)
        {
            NotifySuccess(L["If that account still needs confirming, we sent a new link."]);

            return;
        }

        NotifyError(result.Error ?? L["Could not send the email."]);
    }

    /// <summary>Leaves the app for the provider's sign-in page (the API redirects back to /auth/callback).</summary>
    /// <param name="provider">The provider name.</param>
    private void ExternalSignIn(string provider)
    {
        Navigation.NavigateTo(Auth.GetExternalLoginUrl(provider), forceLoad: true);
    }
}