@page "/oil-types"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits PageBase
@inject IOilTypeApiService OilTypeApi
@inject DialogService Dialogs

<div class="page">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <h1>@L["Oil types"]</h1>
        <RadzenButton Text="@L["Add oil type"]" Icon="add" Disabled="@IsRunning("add")" Click="@(() => RunOnceAsync("add", () => EditAsync(null)))" />
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Body2">
        @L["The oil types your equipment can require (SAE 10W-30, synthetic 5W-30, 2-cycle mix, ...). Each piece of equipment requires one, and its oil change steps show which to use."]
    </RadzenText>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid class="app-grid" Responsive="true" Data="_oilTypes" TItem="OilTypeResponse" IsLoading="_loading" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="OilTypeResponse" Property="Name" Title="@L["Name"]" />
            <RadzenDataGridColumn TItem="OilTypeResponse" Title="" Sortable="false" Width="110px">
                <Template Context="type">
                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@IsRunning($"edit-{type.Id}")" Click="@(() => RunOnceAsync($"edit-{type.Id}", () => EditAsync(type)))" />
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@IsRunning($"delete-{type.Id}")" Click="@(() => RunOnceAsync($"delete-{type.Id}", () => DeleteAsync(type)))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<OilTypeResponse> _oilTypes = [];

    private string? _error;

    private bool _loading = true;

    /// <inheritdoc />
    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    /// <summary>Loads the oil types.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await OilTypeApi.ListAsync(Cancellation);

        _oilTypes = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        _loading = false;
    }

    /// <summary>Prompts for a name, adds or edits the oil type, then reloads.</summary>
    /// <param name="type">The type to rename, or <see langword="null"/> to add one.</param>
    /// <returns>A task.</returns>
    private async Task EditAsync(OilTypeResponse? type)
    {
        var parameters = new Dictionary<string, object?> { [nameof(OilTypeEditor.Existing)] = type };

        var saved = await Dialogs.OpenAsync<OilTypeEditor>(type is null ? L["Add oil type"] : L["Edit oil type"], parameters, new DialogOptions { Width = "400px" });

        if (saved is true)
        {
            await LoadAsync();
        }
    }

    /// <summary>Deletes a type after confirmation; the API refuses while it is in use.</summary>
    /// <param name="type">The type.</param>
    /// <returns>A task.</returns>
    private async Task DeleteAsync(OilTypeResponse type)
    {
        var confirmed = await Dialogs.Confirm(L["Delete {0}?", type.Name], L["Delete oil type"], new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] });

        if (confirmed is not true)
        {
            return;
        }

        var result = await OilTypeApi.DeleteAsync(type.Id, Cancellation);

        if (!result.IsSuccess)
        {
            NotifyError(result.Error ?? L["Could not delete the oil type."]);

            return;
        }

        NotifySuccess(L["Oil type deleted."]);

        await LoadAsync();
    }
}
