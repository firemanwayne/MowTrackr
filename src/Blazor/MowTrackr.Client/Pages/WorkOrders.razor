@page "/work-orders"
@attribute [Authorize]
@inherits PageBase
@inject IMaintenanceApiService MaintenanceApi
@inject NavigationManager Navigation

<div class="page">
    <h1>@L["Work orders"]</h1>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-my-2">
        <RadzenLabel Text="@L["Show"]" Component="Status" />
        <RadzenDropDown TValue="string" @bind-Value="_status" Data="_statuses" TextProperty="Text" ValueProperty="Value" Name="Status" Change="@(_ => ApplyFilter())" />
    </RadzenStack>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid class="app-grid" Responsive="true" AllowColumnResize="true" ColumnWidth="150px" Data="_view" TItem="WorkOrderResponse" IsLoading="_loading" AllowSorting="true" RowClick="@(args => Navigation.NavigateTo($"work-orders/{args.Data?.Id}"))">
        <Columns>
            <RadzenDataGridColumn TItem="WorkOrderResponse" Property="MowerName" Title="@L["Mower"]" />
            <RadzenDataGridColumn TItem="WorkOrderResponse" Property="TemplateName" Title="@L["Service"]" />
            <RadzenDataGridColumn TItem="WorkOrderResponse" Property="ScheduledFor" Title="@L["Scheduled"]" FormatString="{0:d}" />
            <RadzenDataGridColumn TItem="WorkOrderResponse" Title="@L["Progress"]">
                <Template Context="order">
                    @order.Tasks.Count(t => t.IsComplete) / @order.Tasks.Count
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="WorkOrderResponse" Property="Status" Title="@L["Status"]">
                <Template Context="order">
                    <RadzenBadge Text="@StatusText(order.Status)" BadgeStyle="@StatusStyle(order.Status)" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private sealed record StatusOption(string Value, string Text);

    private List<WorkOrderResponse> _orders = [];

    private List<WorkOrderResponse> _view = [];

    private List<StatusOption> _statuses = [];

    private string _status = "all";

    private string? _error;

    private bool _loading = true;

    /// <summary>Gets or sets the initial filter from the query string (all, open or completed).</summary>
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _statuses =
        [
            new StatusOption("all", L["All"]),
            new StatusOption("open", L["Open"]),
            new StatusOption("completed", L["Completed"]),
        ];

        var result = await MaintenanceApi.ListWorkOrdersAsync(Cancellation);

        _orders = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        ApplyFilter();

        _loading = false;
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _status = _statuses.Any(s => s.Value == Status) ? Status! : "all";

        ApplyFilter();
    }

    /// <summary>Filters the loaded work orders by the selected view.</summary>
    private void ApplyFilter()
    {
        _view = _status switch
        {
            "open" => _orders.Where(o => o.Status is WorkOrderStatus.Scheduled or WorkOrderStatus.InProgress).ToList(),
            "completed" => _orders.Where(o => o.Status == WorkOrderStatus.Completed).ToList(),
            _ => _orders,
        };
    }
}