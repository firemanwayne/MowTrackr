@page "/profile"
@attribute [Authorize]
@inherits PageBase
@inject IUserApiService UserApi
@inject IPreferencesService Preferences
@inject NavigationManager Navigation
@inject DialogService Dialogs

<PageTitle>@L["My profile"] - MowTrackr</PageTitle>

<div class="page">
    <h1>@L["My profile"]</h1>
    @if (_user is null)
    {
        <p>@L["Loading..."]</p>
    }
    else
    {
        <RadzenCard Style="max-width: 480px">
            <EditForm Model="_model" OnValidSubmit="@(() => RunOnceAsync("save", SaveAsync))">
                <DataAnnotationsValidator />
                <RadzenStack Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                        @_user.Email &middot; @string.Join(", ", _user.Roles)
                        <RadzenBadge Text="@(_user.EmailConfirmed ? L["Email verified"] : L["Email not verified"])" BadgeStyle="@(_user.EmailConfirmed ? BadgeStyle.Success : BadgeStyle.Warning)" />
                    </RadzenText>
                    <div>
                        <RadzenLabel Text="@L["Display name"]" Component="DisplayName" />
                        <RadzenTextBox @bind-Value="_model.DisplayName" Name="DisplayName" Style="width: 100%" />
                        <ValidationMessage For="@(() => _model.DisplayName)" />
                    </div>
                    <div>
                        <RadzenLabel Text="@L["Phone"]" Component="Phone" />
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                                @(string.IsNullOrWhiteSpace(_user.PhoneNumber) ? L["No phone number"] : _user.PhoneNumber)
                            </RadzenText>
                            @if (!string.IsNullOrWhiteSpace(_user.PhoneNumber))
                            {
                                <RadzenBadge Text="@(_user.PhoneNumberConfirmed ? L["Verified"] : L["Not verified"])" BadgeStyle="@(_user.PhoneNumberConfirmed ? BadgeStyle.Success : BadgeStyle.Warning)" />
                            }
                            <RadzenButton Text="@(string.IsNullOrWhiteSpace(_user.PhoneNumber) ? L["Add and verify"] : L["Change"])" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => RunOnceAsync("phone", VerifyPhoneAsync))" />
                        </RadzenStack>
                    </div>
                    <div>
                        <RadzenLabel Text="@L["Language"]" Component="Language" />
                        <RadzenDropDown TValue="string" @bind-Value="_model.Language" Data="_languages" TextProperty="Text" ValueProperty="Value" Name="Language" Style="width: 100%" />
                    </div>
                    <div>
                        <RadzenLabel Text="@L["Appearance"]" Component="Theme" />
                        <RadzenDropDown TValue="string" @bind-Value="_model.Theme" Data="_themes" TextProperty="Text" ValueProperty="Value" Name="Theme" Style="width: 100%" />
                    </div>
                    <div>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" IsBusy="@IsRunning("save")" Disabled="@IsRunning("save")" />
                    </div>
                </RadzenStack>
            </EditForm>
        </RadzenCard>
    }
</div>

@code {
    private sealed record Option(string Value, string Text);

    private readonly UpdateProfileRequest _model = new();

    private List<Option> _languages = [];

    private List<Option> _themes = [];

    private UserResponse? _user;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _languages = [new Option(AppLanguages.English, "English"), new Option(AppLanguages.Spanish, "Espa\u00f1ol")];

        _themes = [new Option(AppThemes.Light, L["Light"]), new Option(AppThemes.Dark, L["Dark"])];

        var result = await UserApi.GetMeAsync(Cancellation);

        if (!result.IsSuccess || result.Value is null)
        {
            NotifyError(result.Error ?? L["Could not load your profile."]);

            return;
        }

        _user = result.Value;

        _model.DisplayName = _user.DisplayName;

        _model.Language = _user.Language;

        _model.Theme = _user.Theme;
    }

    /// <summary>Saves the profile. The theme applies immediately; a changed language reloads the page so every string switches.</summary>
    /// <returns>A task.</returns>
    private async Task SaveAsync()
    {
        var result = await UserApi.UpdateMeAsync(_model, Cancellation);

        if (!result.IsSuccess || result.Value is null)
        {
            NotifyError(result.Error ?? L["Could not save your profile."]);

            return;
        }

        _user = result.Value;

        var reload = await Preferences.ApplyProfileAsync(_user);

        if (reload)
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

            return;
        }

        NotifySuccess(L["Profile saved."]);
    }

    /// <summary>Opens the phone verification dialog and reloads the profile if a number was verified.</summary>
    /// <returns>A task.</returns>
    private async Task VerifyPhoneAsync()
    {
        var verified = await Dialogs.OpenAsync<PhoneVerifier>(L["Verify your phone"], null, new DialogOptions { Width = "460px" });

        if (verified is not true)
        {
            return;
        }

        var result = await UserApi.GetMeAsync(Cancellation);

        if (result.IsSuccess && result.Value is not null)
        {
            _user = result.Value;
        }
    }
}