@page "/service-templates"
@attribute [Authorize(Roles = AppRoles.ManagerOrAdmin)]
@inherits PageBase
@inject IServiceTemplateApiService TemplateApi
@inject DialogService Dialogs

<PageTitle>@L["Service templates"] - MowTrackr</PageTitle>

<div class="page">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <h1>@L["Service templates"]</h1>
        <RadzenButton Text="@L["New template"]" Icon="add" Disabled="@IsRunning("add")" Click="@(() => RunOnceAsync("add", () => EditAsync(null)))" />
    </RadzenStack>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid class="app-grid" Responsive="true" AllowColumnResize="true" ColumnWidth="150px" Data="_templates" TItem="ServiceTemplateResponse" IsLoading="_loading" AllowSorting="true">
        <EmptyTemplate>
            <p class="empty-state">@L["No service templates yet. A template defines a service: its steps, and when it is due."]</p>
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="ServiceTemplateResponse" Property="Name" Title="@L["Name"]" MinWidth="200px" />
            <RadzenDataGridColumn TItem="ServiceTemplateResponse" Property="AssetTypeNames" Title="@L["Applies to"]" MinWidth="200px" />
            <RadzenDataGridColumn TItem="ServiceTemplateResponse" Title="@L["Due every"]">
                <Template Context="template">
                    @DescribeInterval(template)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ServiceTemplateResponse" Title="@L["Tasks"]">
                <Template Context="template">
                    @template.Tasks.Count
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ServiceTemplateResponse" Title="@L["Status"]">
                <Template Context="template">
                    <RadzenBadge Text="@(template.IsActive ? L["Active"] : L["Inactive"])" BadgeStyle="@(template.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ServiceTemplateResponse" Title="" Sortable="false" Width="110px">
                <Template Context="template">
                    <RadzenButton Icon="edit" title="@L["Edit"]" aria-label="@L["Edit"]" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@IsRunning($"edit-{template.Id}")" Click="@(() => RunOnceAsync($"edit-{template.Id}", () => EditAsync(template)))" />
                    <RadzenButton Icon="delete" title="@L["Delete"]" aria-label="@L["Delete"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@IsRunning($"delete-{template.Id}")" Click="@(() => RunOnceAsync($"delete-{template.Id}", () => DeleteAsync(template)))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<ServiceTemplateResponse> _templates = [];

    private string? _error;

    private bool _loading = true;

    /// <inheritdoc />
    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    /// <summary>Formats a template's interval for display.</summary>
    /// <param name="template">The template.</param>
    /// <returns>For example "50 hrs or 90 days".</returns>
    private string DescribeInterval(ServiceTemplateResponse template)
    {
        var parts = new List<string>();

        if (template.IntervalHours is { } hours)
        {
            parts.Add($"{hours:0.##} {L["hrs"]}");
        }

        if (template.IntervalDays is { } days)
        {
            parts.Add($"{days} {L["days"]}");
        }

        return string.Join($" {L["or"]} ", parts);
    }

    /// <summary>Loads the templates.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await TemplateApi.ListAsync(Cancellation);

        _templates = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        _loading = false;
    }

    /// <summary>Opens the editor for a new or existing template and reloads if it was saved.</summary>
    /// <param name="template">The template to edit, or <see langword="null"/> to create one.</param>
    /// <returns>A task.</returns>
    private async Task EditAsync(ServiceTemplateResponse? template)
    {
        var parameters = new Dictionary<string, object?> { [nameof(ServiceTemplateEditor.Existing)] = template };

        var saved = await Dialogs.OpenAsync<ServiceTemplateEditor>(template is null ? L["New service template"] : L["Edit service template"], parameters, new DialogOptions { Width = "720px" });

        if (saved is true)
        {
            await LoadAsync();
        }
    }

    /// <summary>Deletes a template after confirmation.</summary>
    /// <param name="template">The template.</param>
    /// <returns>A task.</returns>
    private async Task DeleteAsync(ServiceTemplateResponse template)
    {
        var confirmed = await Dialogs.Confirm(L["Delete {0}?", template.Name], L["Delete template"], new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] });

        if (confirmed is not true)
        {
            return;
        }

        var result = await TemplateApi.DeleteAsync(template.Id, Cancellation);

        if (!result.IsSuccess)
        {
            NotifyError(result.Error ?? L["Could not delete the template."]);

            return;
        }

        NotifySuccess(L["Template deleted."]);

        await LoadAsync();
    }
}