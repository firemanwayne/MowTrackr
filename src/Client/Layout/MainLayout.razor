@inherits LayoutComponentBase
@inject ISessionService Session
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <div class="app-header">
            <div class="app-header__start">
                <AuthorizeView>
                    <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
                </AuthorizeView>
            </div>
            <a class="app-brand" href="">
                <img class="app-logo" src="assets/icon-192.png" alt="" width="32" height="32" />
                <span class="app-brand__name">MowTrackr</span>
            </a>
            <div class="app-header__end">
                <AuthorizeView>
                    <Authorized>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                            @context.User.Identity?.Name
                        </RadzenText>
                        <RadzenButton Text="@L["Sign out"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Click="SignOutAsync" />
                    </Authorized>
                    <NotAuthorized>
                        <RadzenButton Text="@L["Sign in"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("login"))" />
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </RadzenHeader>
    <AuthorizeView>
        <Authorized Context="signedIn">
            <RadzenSidebar @bind-Expanded="_sidebarExpanded">
                <RadzenPanelMenu>
                    <RadzenPanelMenuItem Text="@L["Home"]" Path="" Icon="home" Match="NavLinkMatch.All" />
                    <RadzenPanelMenuItem Text="@L["Mowers"]" Path="mowers" Icon="agriculture" />
                    <RadzenPanelMenuItem Text="@L["Work orders"]" Path="work-orders" Icon="assignment" />
                    <AuthorizeView Roles="@AppRoles.ManagerOrAdmin" Context="manager">
                        <RadzenPanelMenuItem Text="@L["Due maintenance"]" Path="maintenance" Icon="build" />
                        <RadzenPanelMenuItem Text="@L["Service templates"]" Path="service-templates" Icon="checklist" />
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                        <RadzenPanelMenuItem Text="@L["Users & roles"]" Path="users" Icon="group" />
                    </AuthorizeView>
                    <RadzenPanelMenuItem Text="@L["My profile"]" Path="profile" Icon="person" />
                </RadzenPanelMenu>
            </RadzenSidebar>
        </Authorized>
    </AuthorizeView>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {
    private bool _sidebarExpanded = true;

    /// <summary>Ends the session and returns to the sign-in page.</summary>
    /// <returns>A task.</returns>
    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();

        Navigation.NavigateTo("login");
    }
}
