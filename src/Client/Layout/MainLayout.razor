@inherits LayoutComponentBase
@implements IDisposable
@inject ISessionService Session
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation
@inject IJSRuntime Js

<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <div class="app-header">
            <div class="app-header__start">
                <AuthorizeView>
                    <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
                </AuthorizeView>
                <a class="app-brand" href="">
                    <img class="app-logo" src="assets/icon-192.png" alt="" width="32" height="32" />
                    <span class="app-brand__name">MowTrackr</span>
                </a>
            </div>
            <div class="app-header__end">
                <AuthorizeView>
                    <Authorized>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                            @context.User.Identity?.Name
                        </RadzenText>
                        <RadzenButton Text="@L["Sign out"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Click="SignOutAsync" />
                    </Authorized>
                    <NotAuthorized>
                        <RadzenButton Text="@L["Sign in"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("login"))" />
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </RadzenHeader>
    <AuthorizeView>
        <Authorized Context="signedIn">
            <RadzenSidebar @bind-Expanded="_sidebarExpanded" Responsive="false">
                <RadzenPanelMenu>
                    <RadzenPanelMenuItem Text="@L["Home"]" Path="" Icon="home" Match="NavLinkMatch.All" />
                    <RadzenPanelMenuItem Text="@L["Mowers"]" Path="mowers" Icon="agriculture" />
                    <RadzenPanelMenuItem Text="@L["Work orders"]" Path="work-orders" Icon="assignment" />
                    <AuthorizeView Roles="@AppRoles.ManagerOrAdmin" Context="manager">
                        <RadzenPanelMenuItem Text="@L["Due maintenance"]" Path="maintenance" Icon="build" />
                        <RadzenPanelMenuItem Text="@L["Service templates"]" Path="service-templates" Icon="checklist" />
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                        <RadzenPanelMenuItem Text="@L["Users & roles"]" Path="users" Icon="group" />
                        <RadzenPanelMenuItem Text="@L["Invitations"]" Path="invitations" Icon="mail" />
                    </AuthorizeView>
                    <RadzenPanelMenuItem Text="@L["My profile"]" Path="profile" Icon="person" />
                </RadzenPanelMenu>
            </RadzenSidebar>
            @if (_sidebarExpanded)
            {
                <div class="app-scrim" @onclick="CloseSidebar"></div>
            }
        </Authorized>
    </AuthorizeView>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {
    private bool _sidebarExpanded = true;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // On a phone the menu is a drawer: start closed, and close it again after every navigation.
        _sidebarExpanded = !await IsMobileAsync();

        Navigation.LocationChanged += OnLocationChanged;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    /// <summary>Ends the session and returns to the sign-in page.</summary>
    /// <returns>A task.</returns>
    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();

        Navigation.NavigateTo("login");
    }

    /// <summary>Closes the navigation drawer (used by the backdrop on phones).</summary>
    private void CloseSidebar()
    {
        _sidebarExpanded = false;
    }

    /// <summary>Closes the drawer when the user navigates on a phone.</summary>
    /// <param name="sender">The navigation manager.</param>
    /// <param name="e">The navigation details.</param>
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (await IsMobileAsync() && _sidebarExpanded)
        {
            _sidebarExpanded = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Checks whether the browser is currently phone-sized.</summary>
    /// <returns><see langword="true"/> on a phone-sized screen.</returns>
    private async Task<bool> IsMobileAsync()
    {
        try
        {
            return await Js.InvokeAsync<bool>("mowtrackrLayout.isMobile");
        }
        catch (JSException)
        {
            return false;
        }
    }
}