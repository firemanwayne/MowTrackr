@using MowTrackr.Client.Services
@inherits PageBase
@inject IJSRuntime Js

<div class="label-scan">
    <InputFile @ref="_input" OnChange="OnPickedAsync" accept="image/*" capture="environment" hidden aria-hidden="true" tabindex="-1" />
    <RadzenButton Text="@L["Scan label"]" Icon="photo_camera" Variant="Variant.Outlined" IsBusy="@_busy" Disabled="@(_busy || IsRunning("scan"))" Click="OpenPickerAsync" />
    @if (_busy)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 rz-mt-2" role="status">
            @L["Reading the label... {0}%", _progress]
        </RadzenText>
    }
    @if (_summary is not null)
    {
        <RadzenAlert AlertStyle="@(_found ? AlertStyle.Success : AlertStyle.Warning)" AllowClose="false" Variant="Variant.Flat" class="rz-mt-2">
            @_summary
        </RadzenAlert>
    }
    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Variant="Variant.Flat" class="rz-mt-2">
            @_error
        </RadzenAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_rawText))
    {
        <details class="label-scan__raw">
            <summary>@L["What the camera read"] (@_confidence%)</summary>
            <pre>@_rawText</pre>
        </details>
    }
</div>

@code {
    private InputFile? _input;

    private bool _busy;

    private bool _found;

    private int _progress;

    private int _confidence;

    private string? _summary;

    private string? _error;

    private string? _rawText;

    /// <summary>Gets or sets what to do with the manufacturer, model and serial number that were read.</summary>
    [Parameter]
    public EventCallback<LabelReading> OnRead { get; set; }

    /// <summary>Called by the browser script while the label is being read.</summary>
    /// <param name="percent">How far along the reading is.</param>
    /// <returns>A task.</returns>
    [JSInvokable]
    public Task OnProgress(int percent)
    {
        _progress = percent;

        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Opens the camera (or photo picker) on the device.</summary>
    /// <returns>A task.</returns>
    private async Task OpenPickerAsync()
    {
        _error = null;

        await Js.InvokeVoidAsync("mowtrackrLabel.openPicker", _input!.Element);
    }

    /// <summary>A photo was taken or chosen: read it, once at a time.</summary>
    /// <param name="args">The file picker event.</param>
    /// <returns>A task.</returns>
    private Task OnPickedAsync(InputFileChangeEventArgs args)
    {
        return RunOnceAsync("scan", ScanAsync);
    }

    /// <summary>Reads the label in the chosen photo and hands the result to the form.</summary>
    /// <returns>A task.</returns>
    private async Task ScanAsync()
    {
        _busy = true;

        _progress = 0;

        _summary = null;

        _error = null;

        _rawText = null;

        await InvokeAsync(StateHasChanged);

        using var self = DotNetObjectReference.Create(this);

        try
        {
            var result = await Js.InvokeAsync<ScanResult>("mowtrackrLabel.recognize", Cancellation, _input!.Element, self);

            _rawText = result.Text;

            _confidence = result.Confidence;

            var reading = LabelTextParser.Parse(result.Text);

            _found = !reading.IsEmpty;

            _summary = _found
                ? L["We read the label. Check these before saving: {0}", Describe(reading)]
                : L["We could not find a manufacturer, model or serial number. Try again with the label flat, well lit and filling the photo."];

            if (_found)
            {
                await OnRead.InvokeAsync(reading);
            }
        }
        catch (JSException)
        {
            _error = L["Could not read the label."];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Lists what was found, for the confirmation message.</summary>
    /// <param name="reading">What was read.</param>
    /// <returns>For example "Manufacturer: Toro, Model: 74591".</returns>
    private string Describe(LabelReading reading)
    {
        var parts = new List<string>();

        if (reading.Manufacturer is not null)
        {
            parts.Add($"{L["Manufacturer"]}: {reading.Manufacturer}");
        }

        if (reading.Model is not null)
        {
            parts.Add($"{L["Model"]}: {reading.Model}");
        }

        if (reading.SerialNumber is not null)
        {
            parts.Add($"{L["Serial number"]}: {reading.SerialNumber}");
        }

        return string.Join(", ", parts);
    }

    private sealed record ScanResult(string Text, int Confidence);
}