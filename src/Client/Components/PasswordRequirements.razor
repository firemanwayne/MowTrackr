@inherits PageBase

<ul class="pw-rules" aria-label="@L["Password requirements"]">
    @foreach (var rule in _shown)
    {
        var met = !string.IsNullOrEmpty(Password) && !_failed.Contains(rule);

        <li class="@(met ? "pw-rule pw-rule--met" : "pw-rule")">
            <RadzenIcon Icon="@(met ? "check_circle" : "radio_button_unchecked")" />
            <span>@Describe(rule)</span>
        </li>
    }
</ul>

@code {
    private static readonly PasswordRule[] _shown =
    [
        PasswordRule.MinimumLength,
        PasswordRule.Uppercase,
        PasswordRule.Lowercase,
        PasswordRule.Digit,
        PasswordRule.Symbol,
        PasswordRule.NoPersonalInfo,
        PasswordRule.NotCommon,
    ];

    private IReadOnlyList<PasswordRule> _failed = [];

    /// <summary>Gets or sets the password being typed.</summary>
    [Parameter]
    public string? Password { get; set; }

    /// <summary>Gets or sets values about the user (email, display name) the password must not contain.</summary>
    [Parameter]
    public IReadOnlyList<string?>? PersonalInfo { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _failed = PasswordPolicy.Failures(Password, PersonalInfo);
    }

    /// <summary>Gets the localized text of a rule.</summary>
    /// <param name="rule">The rule.</param>
    /// <returns>The text.</returns>
    private string Describe(PasswordRule rule)
    {
        return rule switch
        {
            PasswordRule.MinimumLength => L["At least {0} characters", PasswordPolicy.MinLength],
            PasswordRule.Uppercase => L["An upper-case letter"],
            PasswordRule.Lowercase => L["A lower-case letter"],
            PasswordRule.Digit => L["A digit"],
            PasswordRule.Symbol => L["A symbol, such as ! or #"],
            PasswordRule.NoPersonalInfo => L["Does not contain your name or email"],
            PasswordRule.NotCommon => L["Not a common password"],
            _ => rule.ToString(),
        };
    }
}