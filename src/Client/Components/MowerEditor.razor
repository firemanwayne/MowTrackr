@inherits PageBase
@inject IMowerApiService MowerApi
@inject IManufacturerApiService ManufacturerApi
@inject DialogService Dialogs

<EditForm Model="_model" OnValidSubmit="@(() => RunOnceAsync("save", SaveAsync))">
    <DataAnnotationsValidator />
    <RadzenStack Gap="0.75rem">
        <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
            @_error
        </RadzenAlert>
        <LabelScanner OnRead="OnLabelReadAsync" />
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Name"]" Component="Name" />
                <RadzenTextBox @bind-Value="_model.Name" Name="Name" Style="width: 100%" />
                <ValidationMessage For="@(() => _model.Name)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Serial number"]" Component="SerialNumber" />
                <RadzenTextBox @bind-Value="_model.SerialNumber" Name="SerialNumber" Style="width: 100%" />
                <ValidationMessage For="@(() => _model.SerialNumber)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Manufacturer"]" Component="Manufacturer" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenDropDown TValue="Guid?" Value="_model.ManufacturerId" ValueChanged="OnManufacturerChanged" Data="_manufacturers" TextProperty="Name" ValueProperty="Id" Name="Manufacturer" AllowFiltering="true" Placeholder="@L["Select a manufacturer"]" Style="width: 100%" />
                    <AuthorizeView Roles="@AppRoles.ManagerOrAdmin" Context="manager">
                        <RadzenButton Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light" title="@L["Add manufacturer"]" Click="@(() => RunOnceAsync("add-manufacturer", AddManufacturerAsync))" />
                    </AuthorizeView>
                </RadzenStack>
                <ValidationMessage For="@(() => _model.ManufacturerId)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Model"]" Component="Model" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenDropDown TValue="Guid?" @bind-Value="_model.ManufacturerModelId" Data="CurrentModels" TextProperty="Name" ValueProperty="Id" Name="Model" AllowFiltering="true" Disabled="@(_model.ManufacturerId is null)" Placeholder="@L["Select a model"]" Style="width: 100%" />
                    <AuthorizeView Roles="@AppRoles.ManagerOrAdmin" Context="manager">
                        <RadzenButton Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light" title="@L["Add model"]" Disabled="@(_model.ManufacturerId is null)" Click="@(() => RunOnceAsync("add-model", AddModelAsync))" />
                    </AuthorizeView>
                </RadzenStack>
                <ValidationMessage For="@(() => _model.ManufacturerModelId)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Purchase date"]" Component="PurchaseDate" />
                <RadzenDatePicker TValue="DateOnly" @bind-Value="_model.PurchaseDate" Name="PurchaseDate" DateFormat="d" Style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Engine hours"]" Component="EngineHours" />
                <RadzenNumeric TValue="decimal" @bind-Value="_model.EngineHours" Name="EngineHours" Min="0" Step="0.1" Style="width: 100%" />
                <ValidationMessage For="@(() => _model.EngineHours)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Oil type"]" Component="OilType" />
                <RadzenTextBox @bind-Value="_model.OilType" Name="OilType" Placeholder="@L["e.g. SAE 10W-30"]" Style="width: 100%" />
                <ValidationMessage For="@(() => _model.OilType)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Oil quantity (quarts)"]" Component="OilQuantity" />
                <RadzenNumeric TValue="decimal" @bind-Value="_model.OilQuantityQuarts" Name="OilQuantity" Min="0" Step="0.25" Style="width: 100%" />
                <ValidationMessage For="@(() => _model.OilQuantityQuarts)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="@L["Last oil change"]" Component="LastOilChange" />
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="_model.LastOilChange" Name="LastOilChange" DateFormat="d" AllowClear="true" Style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCheckBox TValue="bool" @bind-Value="_model.IsActive" Name="IsActive" />
                <RadzenLabel Text="@L["In service"]" Component="IsActive" class="rz-ms-2" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" IsBusy="@IsRunning("save")" Disabled="@IsRunning("save")" />
        </RadzenStack>
    </RadzenStack>
</EditForm>

@code {
    private MowerRequest _model = new();

    private string? _error;

    private List<ManufacturerResponse> _manufacturers = [];

    /// <summary>Gets or sets the mower being edited; <see langword="null"/> adds a new one.</summary>
    [Parameter]
    public MowerResponse? Existing { get; set; }

    /// <summary>Gets the models belonging to the selected manufacturer.</summary>
    private IReadOnlyList<ManufacturerModelResponse> CurrentModels =>
        _manufacturers.FirstOrDefault(m => m.Id == _model.ManufacturerId)?.Models ?? [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var result = await ManufacturerApi.ListAsync(Cancellation);

        _manufacturers = result.Value ?? [];

        if (!result.IsSuccess)
        {
            _error = result.Error;
        }

        if (Existing is null)
        {
            return;
        }

        _model = new MowerRequest
        {
            Name = Existing.Name,
            ManufacturerId = Existing.ManufacturerId,
            ManufacturerModelId = Existing.ManufacturerModelId,
            SerialNumber = Existing.SerialNumber,
            PurchaseDate = Existing.PurchaseDate,
            EngineHours = Existing.EngineHours,
            OilType = Existing.OilType,
            LastOilChange = Existing.LastOilChange,
            OilQuantityQuarts = Existing.OilQuantityQuarts,
            IsActive = Existing.IsActive,
        };
    }

    /// <summary>Fills in the fields that were read from the label; the technician still reviews them before saving.</summary>
    /// <param name="reading">What was read.</param>
    /// <returns>A completed task.</returns>
    private Task OnLabelReadAsync(LabelReading reading)
    {
        var manufacturer = _manufacturers.FirstOrDefault(m => string.Equals(m.Name, reading.Manufacturer, StringComparison.OrdinalIgnoreCase));

        if (manufacturer is not null)
        {
            OnManufacturerChanged(manufacturer.Id);

            var model = manufacturer.Models.FirstOrDefault(m => string.Equals(m.Name, reading.Model, StringComparison.OrdinalIgnoreCase));

            _model.ManufacturerModelId = model?.Id ?? _model.ManufacturerModelId;
        }

        _model.SerialNumber = reading.SerialNumber ?? _model.SerialNumber;

        return Task.CompletedTask;
    }

    /// <summary>Selects a manufacturer and clears the model if it does not belong to it.</summary>
    /// <param name="manufacturerId">The chosen manufacturer key.</param>
    private void OnManufacturerChanged(Guid? manufacturerId)
    {
        if (_model.ManufacturerId == manufacturerId)
        {
            return;
        }

        _model.ManufacturerId = manufacturerId;

        _model.ManufacturerModelId = null;
    }

    /// <summary>Prompts for a new manufacturer name, adds it and selects it.</summary>
    /// <returns>A task.</returns>
    private async Task AddManufacturerAsync()
    {
        var saved = await PromptAsync(L["Add manufacturer"], async (request, token) =>
        {
            var result = await ManufacturerApi.CreateAsync(request, token);

            return (result.IsSuccess ? result.Value?.Id : null, result.Error);
        });

        if (saved is null)
        {
            return;
        }

        await ReloadAsync();

        OnManufacturerChanged(saved);
    }

    /// <summary>Prompts for a new model name under the selected manufacturer, adds it and selects it.</summary>
    /// <returns>A task.</returns>
    private async Task AddModelAsync()
    {
        if (_model.ManufacturerId is not { } manufacturerId)
        {
            return;
        }

        var saved = await PromptAsync(L["Add model"], async (request, token) =>
        {
            var result = await ManufacturerApi.CreateModelAsync(manufacturerId, request, token);

            return (result.IsSuccess ? result.Value?.Id : null, result.Error);
        });

        if (saved is null)
        {
            return;
        }

        await ReloadAsync();

        _model.ManufacturerModelId = saved;
    }

    /// <summary>Opens the name prompt dialog.</summary>
    /// <param name="title">The dialog title.</param>
    /// <param name="onSave">Saves the entered name, returning the new key or an error.</param>
    /// <returns>The new key, or <see langword="null"/> if cancelled.</returns>
    private async Task<Guid?> PromptAsync(string title, Func<ManufacturerRequest, CancellationToken, Task<(Guid? Id, string? Error)>> onSave)
    {
        var parameters = new Dictionary<string, object?> { [nameof(LookupNameEditor.OnSave)] = onSave };

        return await Dialogs.OpenAsync<LookupNameEditor>(title, parameters, new DialogOptions { Width = "400px" }) as Guid?;
    }

    /// <summary>Reloads the manufacturer and model lists.</summary>
    /// <returns>A task.</returns>
    private async Task ReloadAsync()
    {
        var result = await ManufacturerApi.ListAsync(Cancellation);

        _manufacturers = result.Value ?? _manufacturers;
    }

    /// <summary>Saves the mower and closes the dialog.</summary>
    /// <returns>A task.</returns>
    private async Task SaveAsync()
    {
        _error = null;

        var result = Existing is null
            ? await MowerApi.CreateAsync(_model, Cancellation)
            : await MowerApi.UpdateAsync(Existing.Id, _model, Cancellation);

        if (result.IsSuccess)
        {
            NotifySuccess(L["Mower saved."]);

            Dialogs.Close(true);

            return;
        }

        _error = result.Error;
    }
}