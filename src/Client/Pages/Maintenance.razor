@page "/maintenance"
@attribute [Authorize(Roles = AppRoles.ManagerOrAdmin)]
@inherits PageBase
@inject IMaintenanceApiService MaintenanceApi
@inject DialogService Dialogs

<div class="page">
    <h1>@L["Due maintenance"]</h1>
    <RadzenText TextStyle="TextStyle.Body2">
        @L["Mowers that are overdue, or will be soon, for each active service template. Schedule a work order to assign the work."]
    </RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-my-2">
        <RadzenLabel Text="@L["Show"]" Component="Filter" />
        <RadzenDropDown TValue="string" @bind-Value="_filter" Data="_filters" TextProperty="Text" ValueProperty="Value" Name="Filter" Change="@(_ => ApplyFilter())" />
    </RadzenStack>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid class="app-grid" Responsive="true" AllowColumnResize="true" ColumnWidth="150px" Data="_view" TItem="MaintenanceDueResponse" IsLoading="_loading" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="MaintenanceDueResponse" Property="MowerName" Title="@L["Mower"]" />
            <RadzenDataGridColumn TItem="MaintenanceDueResponse" Property="TemplateName" Title="@L["Service"]" />
            <RadzenDataGridColumn TItem="MaintenanceDueResponse" Title="@L["Hours until due"]">
                <Template Context="item">
                    @(item.HoursUntilDue is { } hours ? $"{hours:0.#}" : "-")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MaintenanceDueResponse" Title="@L["Days until due"]">
                <Template Context="item">
                    @(item.DaysUntilDue?.ToString() ?? "-")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MaintenanceDueResponse" Title="@L["Status"]">
                <Template Context="item">
                    <RadzenBadge Text="@(item.IsOverdue ? L["Overdue"] : L["Coming due"])" BadgeStyle="@(item.IsOverdue ? BadgeStyle.Danger : BadgeStyle.Warning)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MaintenanceDueResponse" Title="" Sortable="false" Width="140px">
                <Template Context="item">
                    @if (item.HasOpenWorkOrder)
                    {
                        <RadzenBadge Text="@L["Scheduled"]" BadgeStyle="BadgeStyle.Info" />
                    }
                    else
                    {
                        <RadzenButton Text="@L["Schedule"]" Size="ButtonSize.Small" Click="@(() => ScheduleAsync(item))" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private sealed record FilterOption(string Value, string Text);

    private List<MaintenanceDueResponse> _due = [];

    private List<MaintenanceDueResponse> _view = [];

    private List<FilterOption> _filters = [];

    private string _filter = "all";

    private string? _error;

    private bool _loading = true;

    /// <summary>Gets or sets the initial filter from the query string (all, overdue, upcoming or scheduled).</summary>
    [SupplyParameterFromQuery(Name = "filter")]
    public string? Filter { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _filters =
        [
            new FilterOption("all", L["All"]),
            new FilterOption("overdue", L["Overdue"]),
            new FilterOption("upcoming", L["Coming due"]),
            new FilterOption("scheduled", L["Already scheduled"]),
        ];

        await LoadAsync();
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _filter = _filters.Any(f => f.Value == Filter) ? Filter! : "all";

        ApplyFilter();
    }

    /// <summary>Loads the due list.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await MaintenanceApi.GetDueAsync(Cancellation);

        _due = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        ApplyFilter();

        _loading = false;
    }

    /// <summary>Filters the loaded due items by the selected view.</summary>
    private void ApplyFilter()
    {
        _view = _filter switch
        {
            "overdue" => _due.Where(d => d.IsOverdue).ToList(),
            "upcoming" => _due.Where(d => !d.IsOverdue).ToList(),
            "scheduled" => _due.Where(d => d.HasOpenWorkOrder).ToList(),
            _ => _due,
        };
    }

    /// <summary>Opens the scheduler dialog for a due item and reloads if a work order was created.</summary>
    /// <param name="item">The due item.</param>
    /// <returns>A task.</returns>
    private async Task ScheduleAsync(MaintenanceDueResponse item)
    {
        var parameters = new Dictionary<string, object?> { [nameof(WorkOrderScheduler.Item)] = item };

        var saved = await Dialogs.OpenAsync<WorkOrderScheduler>(L["Schedule {0}", item.TemplateName], parameters, new DialogOptions { Width = "480px" });

        if (saved is true)
        {
            await LoadAsync();
        }
    }
}