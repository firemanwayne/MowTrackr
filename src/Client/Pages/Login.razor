@page "/login"
@attribute [AllowAnonymous]
@inherits PageBase
@inject IAuthApiService Auth
@inject ISessionService Session
@inject NavigationManager Navigation

<div class="auth-card">
    <LanguagePicker />
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H5">
            @L["Sign in to MowTrackr"]
        </RadzenText>
        <EditForm Model="_model" OnValidSubmit="SignInAsync">
            <DataAnnotationsValidator />
            <RadzenStack Gap="0.75rem">
                <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false" Variant="Variant.Flat">
                    @_error
                </RadzenAlert>
                <div>
                    <RadzenLabel Text="@L["Email"]" Component="Email" />
                    <RadzenTextBox @bind-Value="_model.Email" Name="Email" Style="width: 100%" AutoComplete="false" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Password"]" Component="Password" />
                    <RadzenPassword @bind-Value="_model.Password" Name="Password" Style="width: 100%" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>
                <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Sign in"]" IsBusy="_busy" />
            </RadzenStack>
        </EditForm>
        @if (_providers.Count > 0)
        {
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-4">
                @L["Or continue with"]
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                @foreach (var provider in _providers)
                {
                    <RadzenButton Text="@provider" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="@(() => ExternalSignIn(provider))" />
                }
            </RadzenStack>
        }
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-4">
            @L["New here?"] <a href="register">@L["Create an account"]</a>
        </RadzenText>
    </RadzenCard>
</div>

@code {
    private readonly LoginRequest _model = new();

    private List<string> _providers = [];

    private string? _error;

    private bool _busy;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var result = await Auth.GetProvidersAsync(Cancellation);

        if (result.IsSuccess)
        {
            _providers = result.Value ?? [];
        }
    }

    /// <summary>Signs in with email and password.</summary>
    /// <returns>A task.</returns>
    private async Task SignInAsync()
    {
        _busy = true;

        _error = null;

        var result = await Auth.LoginAsync(_model, Cancellation);

        if (result.IsSuccess && result.Value is not null)
        {
            var reload = await Session.SignInAsync(result.Value.Token, Cancellation);

            Navigation.NavigateTo("", forceLoad: reload, replace: true);

            return;
        }

        _error = result.Error;

        _busy = false;
    }

    /// <summary>Leaves the app for the provider's sign-in page (the API redirects back to /auth/callback).</summary>
    /// <param name="provider">The provider name.</param>
    private void ExternalSignIn(string provider)
    {
        Navigation.NavigateTo(Auth.GetExternalLoginUrl(provider), forceLoad: true);
    }
}