@page "/auth/callback"
@attribute [AllowAnonymous]
@inherits PageBase
@inject ISessionService Session
@inject NavigationManager Navigation

<div class="auth-card">
    @if (_error is null)
    {
        <p>Finishing sign-in&hellip;</p>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
            @_error
        </RadzenAlert>
        <a href="login">Back to sign in</a>
    }
</div>

@code {
    private string? _error;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);

        var values = ParseFragment(uri.Fragment);

        if (values.TryGetValue("token", out var token) && !string.IsNullOrWhiteSpace(token))
        {
            await Session.SignInAsync(token);

            Navigation.NavigateTo("", replace: true);

            return;
        }

        _error = values.GetValueOrDefault("error") ?? "Sign-in did not complete.";
    }

    /// <summary>Parses a URL fragment of the form <c>#a=b&amp;c=d</c>.</summary>
    /// <param name="fragment">The fragment, including the leading '#'.</param>
    /// <returns>The decoded key/value pairs.</returns>
    private static Dictionary<string, string> ParseFragment(string fragment)
    {
        var result = new Dictionary<string, string>();

        foreach (var pair in fragment.TrimStart('#').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var index = pair.IndexOf('=');

            if (index <= 0)
            {
                continue;
            }

            result[pair[..index]] = Uri.UnescapeDataString(pair[(index + 1)..]);
        }

        return result;
    }
}