@page "/inspection-templates"
@attribute [Authorize(Roles = AppRoles.ManagerOrAdmin)]
@inherits PageBase
@inject IInspectionTemplateApiService TemplateApi
@inject DialogService Dialogs

<div class="page">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <h1>@L["Inspection templates"]</h1>
        <RadzenButton Text="@L["New inspection"]" Icon="add" Disabled="@IsRunning("add")" Click="@(() => RunOnceAsync("add", () => EditAsync(null)))" />
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Body2">
        @L["Extra steps added to a work order once the equipment reaches an age or engine hours."]
    </RadzenText>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid class="app-grid" Responsive="true" AllowColumnResize="true" ColumnWidth="150px" Data="_templates" TItem="InspectionTemplateResponse" IsLoading="_loading" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="InspectionTemplateResponse" Property="DisplayName" Title="@L["Name"]" MinWidth="220px" />
            <RadzenDataGridColumn TItem="InspectionTemplateResponse" Title="@L["Applies at"]">
                <Template Context="template">
                    @DescribeTrigger(template)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="InspectionTemplateResponse" Title="@L["Tasks"]" Width="90px">
                <Template Context="template">
                    @template.Tasks.Count
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="InspectionTemplateResponse" Title="@L["Status"]" Width="110px">
                <Template Context="template">
                    <RadzenBadge Text="@(template.IsActive ? L["Active"] : L["Inactive"])" BadgeStyle="@(template.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="InspectionTemplateResponse" Title="" Sortable="false" Width="110px">
                <Template Context="template">
                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@IsRunning($"edit-{template.Id}")" Click="@(() => RunOnceAsync($"edit-{template.Id}", () => EditAsync(template)))" />
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@IsRunning($"delete-{template.Id}")" Click="@(() => RunOnceAsync($"delete-{template.Id}", () => DeleteAsync(template)))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<InspectionTemplateResponse> _templates = [];

    private string? _error;

    private bool _loading = true;

    /// <inheritdoc />
    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    /// <summary>Formats when an inspection applies.</summary>
    /// <param name="template">The template.</param>
    /// <returns>For example "500 hrs or 36 months".</returns>
    private string DescribeTrigger(InspectionTemplateResponse template)
    {
        var parts = new List<string>();

        if (template.MinEngineHours is { } hours)
        {
            parts.Add($"{hours:0.##} {L["hrs"]}");
        }

        if (template.MinAgeMonths is { } months)
        {
            parts.Add($"{months} {L["months"]}");
        }

        return string.Join($" {L["or"]} ", parts);
    }

    /// <summary>Loads the templates.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await TemplateApi.ListAsync(Cancellation);

        _templates = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        _loading = false;
    }

    /// <summary>Opens the editor for a new or existing template and reloads if it was saved.</summary>
    /// <param name="template">The template to edit, or <see langword="null"/> to create one.</param>
    /// <returns>A task.</returns>
    private async Task EditAsync(InspectionTemplateResponse? template)
    {
        var parameters = new Dictionary<string, object?> { [nameof(InspectionTemplateEditor.Existing)] = template };

        var saved = await Dialogs.OpenAsync<InspectionTemplateEditor>(template is null ? L["New inspection template"] : L["Edit inspection template"], parameters, new DialogOptions { Width = "720px" });

        if (saved is true)
        {
            await LoadAsync();
        }
    }

    /// <summary>Deletes a template after confirmation.</summary>
    /// <param name="template">The template.</param>
    /// <returns>A task.</returns>
    private async Task DeleteAsync(InspectionTemplateResponse template)
    {
        var confirmed = await Dialogs.Confirm(L["Delete {0}?", template.DisplayName], L["Delete inspection"], new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] });

        if (confirmed is not true)
        {
            return;
        }

        var result = await TemplateApi.DeleteAsync(template.Id, Cancellation);

        if (!result.IsSuccess)
        {
            NotifyError(result.Error ?? L["Could not delete the inspection."]);

            return;
        }

        NotifySuccess(L["Inspection deleted."]);

        await LoadAsync();
    }
}
