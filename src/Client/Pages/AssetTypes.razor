@page "/asset-types"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits PageBase
@inject IAssetTypeApiService AssetTypeApi
@inject DialogService Dialogs

<div class="page">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <h1>@L["Asset types"]</h1>
        <RadzenButton Text="@L["Add type"]" Icon="add" Disabled="@IsRunning("add")" Click="@(() => RunOnceAsync("add", () => EditAsync(null)))" />
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Body2">
        @L["The kinds of equipment you track. Each piece of equipment, service template and inspection template belongs to one."]
    </RadzenText>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid class="app-grid" Responsive="true" Data="_types" TItem="AssetTypeResponse" IsLoading="_loading" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="AssetTypeResponse" Property="Name" Title="@L["Name"]" />
            <RadzenDataGridColumn TItem="AssetTypeResponse" Title="" Sortable="false" Width="110px">
                <Template Context="type">
                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@IsRunning($"edit-{type.Id}")" Click="@(() => RunOnceAsync($"edit-{type.Id}", () => EditAsync(type)))" />
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@IsRunning($"delete-{type.Id}")" Click="@(() => RunOnceAsync($"delete-{type.Id}", () => DeleteAsync(type)))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<AssetTypeResponse> _types = [];

    private string? _error;

    private bool _loading = true;

    /// <inheritdoc />
    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    /// <summary>Loads the asset types.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await AssetTypeApi.ListAsync(Cancellation);

        _types = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        _loading = false;
    }

    /// <summary>Prompts for a name and adds or renames a type, then reloads.</summary>
    /// <param name="type">The type to rename, or <see langword="null"/> to add one.</param>
    /// <returns>A task.</returns>
    private async Task EditAsync(AssetTypeResponse? type)
    {
        Func<ManufacturerRequest, CancellationToken, Task<(Guid? Id, string? Error)>> save = async (request, token) =>
        {
            var body = new AssetTypeRequest { Name = request.Name };

            var result = type is null
                ? await AssetTypeApi.CreateAsync(body, token)
                : await AssetTypeApi.UpdateAsync(type.Id, body, token);

            return (result.IsSuccess ? result.Value?.Id : null, result.Error);
        };

        var parameters = new Dictionary<string, object?>
        {
            [nameof(LookupNameEditor.OnSave)] = save,
            [nameof(LookupNameEditor.InitialName)] = type?.Name,
        };

        var saved = await Dialogs.OpenAsync<LookupNameEditor>(type is null ? L["Add type"] : L["Edit type"], parameters, new DialogOptions { Width = "400px" });

        if (saved is Guid)
        {
            await LoadAsync();
        }
    }

    /// <summary>Deletes a type after confirmation; the API refuses while it is in use.</summary>
    /// <param name="type">The type.</param>
    /// <returns>A task.</returns>
    private async Task DeleteAsync(AssetTypeResponse type)
    {
        var confirmed = await Dialogs.Confirm(L["Delete {0}?", type.Name], L["Delete type"], new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] });

        if (confirmed is not true)
        {
            return;
        }

        var result = await AssetTypeApi.DeleteAsync(type.Id, Cancellation);

        if (!result.IsSuccess)
        {
            NotifyError(result.Error ?? L["Could not delete the type."]);

            return;
        }

        NotifySuccess(L["Type deleted."]);

        await LoadAsync();
    }
}
