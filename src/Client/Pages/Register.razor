@page "/register"
@attribute [AllowAnonymous]
@inherits PageBase
@inject IAuthApiService Auth
@inject ISessionService Session
@inject IPreferencesService Preferences
@inject ICultureService Cultures
@inject NavigationManager Navigation

<div class="auth-card">
    <LanguagePicker />
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H5">
            @L["Create your profile"]
        </RadzenText>
        <EditForm Model="_model" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <RadzenStack Gap="0.75rem">
                <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false" Variant="Variant.Flat">
                    @_error
                </RadzenAlert>
                <div>
                    <RadzenLabel Text="@L["Display name"]" Component="DisplayName" />
                    <RadzenTextBox @bind-Value="_model.DisplayName" Name="DisplayName" Style="width: 100%" />
                    <ValidationMessage For="@(() => _model.DisplayName)" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Email"]" Component="Email" />
                    <RadzenTextBox @bind-Value="_model.Email" Name="Email" Style="width: 100%" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>
                <div>
                    <RadzenLabel Text="@L["Password (8+ characters)"]" Component="Password" />
                    <RadzenPassword @bind-Value="_model.Password" Name="Password" Style="width: 100%" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>
                <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Create account"]" IsBusy="_busy" />
            </RadzenStack>
        </EditForm>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-4">
            @L["Already registered?"] <a href="login">@L["Sign in"]</a>
        </RadzenText>
    </RadzenCard>
</div>

@code {
    private readonly RegisterRequest _model = new();

    private string? _error;

    private bool _busy;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var registration = await Auth.GetRegistrationStatusAsync(Cancellation);

        if (registration.IsSuccess && registration.Value?.IsOpen != true)
        {
            Navigation.NavigateTo("login", replace: true);

            return;
        }

        _model.Language = Cultures.GetCurrent();

        _model.Theme = await Preferences.GetThemeAsync();
    }

    /// <summary>Creates the account and signs in. The new profile starts with the language and theme already in effect.</summary>
    /// <returns>A task.</returns>
    private async Task RegisterAsync()
    {
        _busy = true;

        _error = null;

        var result = await Auth.RegisterAsync(_model, Cancellation);

        if (result.IsSuccess && result.Value is not null)
        {
            var reload = await Session.SignInAsync(result.Value.Token, Cancellation);

            Navigation.NavigateTo("", forceLoad: reload, replace: true);

            return;
        }

        _error = result.Error;

        _busy = false;
    }
}