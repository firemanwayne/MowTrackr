@page "/mowers"
@attribute [Authorize]
@inherits PageBase
@inject IMowerApiService MowerApi
@inject DialogService Dialogs

<div class="page">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <h1>Mowers</h1>
        <AuthorizeView Roles="@AppRoles.ManagerOrAdmin">
            <RadzenButton Text="Add mower" Icon="add" Click="@(() => EditAsync(null))" />
        </AuthorizeView>
    </RadzenStack>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid Data="_mowers" TItem="MowerResponse" IsLoading="_loading" AllowSorting="true" AllowFiltering="true" AllowPaging="true" PageSize="15">
        <Columns>
            <RadzenDataGridColumn TItem="MowerResponse" Property="Name" Title="Name" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="Manufacturer" Title="Manufacturer" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="Model" Title="Model" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="SerialNumber" Title="S/N" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="PurchaseDate" Title="Purchased" FormatString="{0:d}" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="EngineHours" Title="Engine hrs" FormatString="{0:0.#}" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="OilType" Title="Oil" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="OilQuantityQuarts" Title="Qts" />
            <RadzenDataGridColumn TItem="MowerResponse" Property="LastOilChange" Title="Last oil change" FormatString="{0:d}" />
            <RadzenDataGridColumn TItem="MowerResponse" Title="Active" Sortable="false" Filterable="false">
                <Template Context="mower">
                    <RadzenBadge Text="@(mower.IsActive ? "Active" : "Retired")" BadgeStyle="@(mower.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" />
                </Template>
            </RadzenDataGridColumn>
            <AuthorizeView Roles="@AppRoles.ManagerOrAdmin">
                <RadzenDataGridColumn TItem="MowerResponse" Title="" Sortable="false" Filterable="false" Width="110px">
                    <Template Context="mower">
                        <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => EditAsync(mower))" />
                        <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteAsync(mower))" />
                    </Template>
                </RadzenDataGridColumn>
            </AuthorizeView>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<MowerResponse> _mowers = [];

    private string? _error;

    private bool _loading = true;

    /// <inheritdoc />
    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    /// <summary>Loads the mowers.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await MowerApi.ListAsync(Cancellation);

        _mowers = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        _loading = false;
    }

    /// <summary>Opens the editor for a new or existing mower and reloads if it was saved.</summary>
    /// <param name="mower">The mower to edit, or <see langword="null"/> to add one.</param>
    /// <returns>A task.</returns>
    private async Task EditAsync(MowerResponse? mower)
    {
        var parameters = new Dictionary<string, object?> { [nameof(MowerEditor.Existing)] = mower };

        var saved = await Dialogs.OpenAsync<MowerEditor>(mower is null ? "Add mower" : "Edit mower", parameters, new DialogOptions { Width = "640px" });

        if (saved is true)
        {
            await LoadAsync();
        }
    }

    /// <summary>Deletes a mower after confirmation.</summary>
    /// <param name="mower">The mower.</param>
    /// <returns>A task.</returns>
    private async Task DeleteAsync(MowerResponse mower)
    {
        var confirmed = await Dialogs.Confirm($"Delete {mower.Name}? This cannot be undone.", "Delete mower", new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed is not true)
        {
            return;
        }

        var result = await MowerApi.DeleteAsync(mower.Id, Cancellation);

        if (!result.IsSuccess)
        {
            NotifyError(result.Error ?? "Could not delete the mower.");

            return;
        }

        NotifySuccess("Mower deleted.");

        await LoadAsync();
    }
}