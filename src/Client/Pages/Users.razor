@page "/users"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inherits PageBase
@inject IUserApiService UserApi

<div class="page">
    <h1>Users &amp; roles</h1>
    <RadzenAlert Visible="@(_error is not null)" AlertStyle="AlertStyle.Danger" AllowClose="false">
        @_error
    </RadzenAlert>
    <RadzenDataGrid Data="_users" TItem="UserResponse" IsLoading="_loading" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="UserResponse" Property="DisplayName" Title="Name" />
            <RadzenDataGridColumn TItem="UserResponse" Property="Email" Title="Email" />
            <RadzenDataGridColumn TItem="UserResponse" Title="Roles" Sortable="false" Width="360px">
                <Template Context="user">
                    <RadzenDropDown TValue="IEnumerable<string>" Multiple="true" Value="user.Roles" Data="AppRoles.All" Change="@(selected => SetRolesAsync(user, selected))" Style="width: 100%" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<UserResponse> _users = [];

    private string? _error;

    private bool _loading = true;

    /// <inheritdoc />
    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    /// <summary>Loads the users.</summary>
    /// <returns>A task.</returns>
    private async Task LoadAsync()
    {
        _loading = true;

        var result = await UserApi.ListAsync(Cancellation);

        _users = result.Value ?? [];

        _error = result.IsSuccess ? null : result.Error;

        _loading = false;
    }

    /// <summary>Saves a user's new role set.</summary>
    /// <param name="user">The user.</param>
    /// <param name="selected">The selected roles (the dropdown's value object).</param>
    /// <returns>A task.</returns>
    private async Task SetRolesAsync(UserResponse user, object selected)
    {
        var roles = (selected as IEnumerable<string> ?? []).ToList();

        var result = await UserApi.SetRolesAsync(user.Id, new SetRolesRequest { Roles = roles }, Cancellation);

        if (result.IsSuccess)
        {
            NotifySuccess($"Roles updated for {user.DisplayName}.");
        }
        else
        {
            NotifyError(result.Error ?? "Could not update roles.");
        }

        await LoadAsync();
    }
}